# Copy this to .env and run ./setup.sh — it will fill in every value below
# with securely generated randomness. You should not need to hand-write
# any of these; everything else (Upstox keys, WhatsApp/Telegram/AI keys)
# is entered through the app itself once it's running, not here.
#
# Why these four and nothing else: they're needed before the app can even
# open a database connection or decrypt anything stored in it — see
# ARCHITECTURE.md, "Credential tiers".

POSTGRES_PASSWORD=
SECRET_KEY=
MASTER_ENCRYPTION_KEY=

# development | production — controls whether auth cookies require HTTPS.
# setup.sh will not touch this one; set it yourself per environment.
ENVIRONMENT=development

# PAPER | LIVE — must stay PAPER until live trading is implemented and
# reviewed (Phase 6+). Changing this is a deliberate, manual, redeploy-only
# action by design — never something the app itself can flip.
TRADING_MODE=PAPER
